# ── Banco de dados ──────────────────────────────────────────────
# Local: PGlite (`npm run local`). Na Vercel, o Neon preenche estas duas sozinho.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1"

# ── Acesso da equipe ────────────────────────────────────────────
# Senha única para entrar no PMedia. Local: sem ela o app fica aberto. Produção: obrigatória.
TEAM_PASSWORD=""
# Opcional: chave para assinar o cookie de sessão (texto aleatório longo)
AUTH_SECRET=""

# ── Mídias (somente Vercel) ─────────────────────────────────────
# Criado pela Vercel ao conectar o Blob em Storage. Sem ele, as mídias vão para ./storage/uploads.
BLOB_READ_WRITE_TOKEN=""
# "1" = navegador envia fotos/vídeos direto ao Blob (necessário para arquivos > 4,5 MB na Vercel)
NEXT_PUBLIC_DIRECT_UPLOAD=""

# ── IA (opcional) ───────────────────────────────────────────────
# Sem chave, /api/ai/parse-task usa o parser heurístico local
ANTHROPIC_API_KEY=""
